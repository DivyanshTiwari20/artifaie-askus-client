# ============================================
# TALLY BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# On AWS EC2, set these in /home/ubuntu/tally-backend/.env
# ============================================

# --- Server Configuration ---
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# --- Database Type ---
# Use 'postgres' for AWS production, 'mongodb' for local testing
DB_TYPE=postgres

# --- PostgreSQL (AWS RDS or Local) ---
# If using AWS RDS, use your RDS endpoint
# If running PostgreSQL locally on EC2, use localhost
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=tally_app
PG_USER=your_pg_username
PG_PASSWORD=your_pg_password
# Set to 'true' for AWS RDS (SSL required), 'false' for local PostgreSQL
PG_SSL=false

# --- MongoDB (Only needed if DB_TYPE=mongodb) ---
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0

# --- JWT Secret ---
# IMPORTANT: Change this to a long random string in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_STRING

# --- Tally Configuration ---
# Your Tally server's IP and port
TALLY_HOST=http://your-tally-server-ip:9000

# --- Tally Company ---
TALLY_COMPANY_NAME=Your Company Name
